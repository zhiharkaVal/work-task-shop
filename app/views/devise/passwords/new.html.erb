<h1 class="header" align="center">Forgot your password?<h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="user-form-margin">
    <div class="field">
      <%= f.label :email, class: 'plaintext' %>
      <%= f.email_field :email, class: 'form-control custom-border', autofocus: true, autocomplete: "email" %>
    </div>
  </div>

  <div class="text-center form-group-lg-margin">
    <div class="btn-group">
      <%= f.submit "Send me reset password instructions", class: 'btn btn-primary custom-btn me-2' %>
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
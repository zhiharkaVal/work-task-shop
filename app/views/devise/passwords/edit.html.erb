<h1 class="header" align="center">Change your password<h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="user-form-margin">
    <div class="field">
      <%= f.label :password, class: 'plaintext', "New password" %>
      <% if @minimum_password_length %>
        <em class="plaintext">(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, class: 'form-control custom-border', autofocus: true, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, class: 'plaintext', "Confirm new password" %>
      <%= f.password_field :password_confirmation, class: 'form-control custom-border', autocomplete: "new-password" %>
    </div>
  </div>

  <div class="text-center form-group-lg-margin">
    <div class="btn-group">
      <%= f.submit "Change my password", class: 'btn btn-primary custom-btn me-2' %>
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
